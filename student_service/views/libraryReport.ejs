<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Library Report</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            color: #333;
            margin: 0;
            padding: 0;
        }

        .header {
            text-align: center;
            border-bottom: 2px solid #2c3e50;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

        .header h1 {
            margin: 0;
            font-size: 22px;
            color: #2c3e50;
        }

        .header p {
            margin: 5px 0;
            font-size: 12px;
            color: #555;
        }

        .student-card {
            border: 1px solid #ddd;
            padding: 12px;
            margin-bottom: 20px;
            border-radius: 5px;
        }

        .student-info {
            display: flex;
            justify-content: space-between;
        }

        .student-info div {
            width: 48%;
        }

        .summary-box {
            margin-top: 10px;
            background: #f4f6f8;
            padding: 10px;
            border-radius: 4px;
        }

        .summary-box span {
            display: inline-block;
            margin-right: 15px;
            font-weight: bold;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        table th {
            background: #2c3e50;
            color: #fff;
            padding: 6px;
            font-size: 12px;
        }

        table td {
            padding: 6px;
            border: 1px solid #ddd;
            font-size: 11px;
        }

        .status-paid {
            color: green;
            font-weight: bold;
        }

        .status-partial {
            color: orange;
            font-weight: bold;
        }

        .status-unpaid {
            color: red;
            font-weight: bold;
        }

        .footer {
            text-align: center;
            font-size: 10px;
            margin-top: 20px;
            color: #777;
        }

        .page-break {
            page-break-after: always;
        }
    </style>
</head>

<body>

<% students.forEach(function(studentData, index) { %>

    <div class="header">
        <h1>Library Management Report</h1>
        <p>Generated on: <%= new Date().toLocaleDateString() %></p>
    </div>

    <div class="student-card">

        <div class="student-info">
            <div>
                <p><strong>Name:</strong> <%= studentData.student?.name || "N/A" %></p>
                <p><strong>Email:</strong> <%= studentData.student?.email || "N/A" %></p>
                <p><strong>Phone:</strong> <%= studentData.student?.phone || "N/A" %></p>
            </div>

            <div>
                <p><strong>Total Books:</strong> <%= studentData.totalBooks %></p>
                <p><strong>Total Amount:</strong> ৳ <%= studentData.totalAmount %></p>
                <p>
                    <strong>Status:</strong>
                    <span class="status-<%= studentData.paymentStatus %>">
                        <%= studentData.paymentStatus.toUpperCase() %>
                    </span>
                </p>
            </div>
        </div>

        <div class="summary-box">
            <span>Book Fee: ৳ <%= studentData.totalBookFee %></span>
            <span>Fine: ৳ <%= studentData.totalFine %></span>
            <span>Paid: ৳ <%= studentData.totalPaid %></span>
            <span>Due: ৳ <%= studentData.totalDue %></span>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Book Name</th>
                    <th>Issue Date</th>
                    <th>Return Date</th>
                    <th>Delay</th>
                    <th>Fee</th>
                    <th>Fine</th>
                    <th>Total</th>
                    <th>Paid</th>
                    <th>Due</th>
                </tr>
            </thead>
            <tbody>
                <% studentData.books.forEach(function(book) { %>
                    <tr>
                        <td><%= book.book?.name || "N/A" %></td>
                        <td><%= book.issue_date ? new Date(book.issue_date).toLocaleDateString() : "-" %></td>
                        <td><%= book.return_date ? new Date(book.return_date).toLocaleDateString() : "-" %></td>
                        <td><%= book.delay_days || 0 %> days</td>
                        <td>৳ <%= book.book_fee %></td>
                        <td>৳ <%= book.calculatedFine || 0 %></td>
                        <td>৳ <%= book.calculatedTotal || 0 %></td>
                        <td>৳ <%= book.paid_amount %></td>
                        <td>৳ <%= book.due_amount %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

    </div>

    <% if(index !== students.length - 1) { %>
        <div class="page-break"></div>
    <% } %>

<% }) %>

<div class="footer">
    Library Report | Confidential Document
</div>

</body>
</html>
