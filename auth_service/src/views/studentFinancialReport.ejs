<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Student Financial Report</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      font-size: 12px;
      margin: 0;
      padding: 0;
    }

    .header {
      text-align: center;
      margin-bottom: 20px;
    }

    .header h1 {
      margin: 0;
      font-size: 18px;
    }

    .header p {
      margin: 0;
      font-size: 12px;
    }

    .summary {
      margin-bottom: 20px;
    }

    .summary table {
      width: 100%;
      border-collapse: collapse;
    }

    .summary th,
    .summary td {
      border: 1px solid #ccc;
      padding: 5px;
      text-align: right;
    }

    .details table {
      width: 100%;
      border-collapse: collapse;
    }

    .details th,
    .details td {
      border: 1px solid #ccc;
      padding: 5px;
      text-align: left;
    }

    .details th {
      background-color: #f2f2f2;
    }
  </style>
</head>

<body>
  <!-- Header -->
  <div class="header">
    <h1>Student Financial Report</h1>
    <p>Date: <%= new Date().toLocaleDateString() %>
    </p>
  </div>

  <!-- Summary -->
  <div class="summary">
    <table>
      <tr>
        <th>Total Amount</th>
        <th>Total Paid</th>
        <th>Total Due</th>
      </tr>
      <tr>
        <td>
          <%= data.summary?.totalAmount?.toFixed(2) || 0 %>
        </td>
        <td>
          <%= data.summary?.totalPaidAmount?.toFixed(2) || 0 %>
        </td>
        <td>
          <%= data.summary?.totalDueAmount?.toFixed(2) || 0 %>
        </td>
      </tr>
    </table>
  </div>

  <!-- Detailed Table -->
  <div class="details">
    <table>
      <thead>
        <tr>
          <th>Student Name</th>
          <th>Course</th>
          <th>Payment Type</th>
          <th>Total Amount</th>
          <th>Paid Amount</th>
          <th>Due Amount</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        <% data.allData.forEach(item=> { %>
          <tr>
            <td>
              <%= item.student.name %>
            </td>
            <td>
              <%= item.course.name %>
            </td>
            <td>
              <%= item.paymentType %>
            </td>
            <td>
              <%= item.totalAmount.toFixed(2) %>
            </td>
            <td>
              <%= item.paidAmount.toFixed(2) %>
            </td>
            <td>
              <%= item.dueAmount.toFixed(2) %>
            </td>
            <td>
              <%= new Date(item.createdAt).toLocaleDateString() %>
            </td>
          </tr>
          <% }) %>
      </tbody>
    </table>
  </div>
</body>

</html>