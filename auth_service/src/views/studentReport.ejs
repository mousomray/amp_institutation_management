<!doctype html>
<html>
<head>
<meta charset="utf-8" />
<title>Student Financial Report</title>

<style>
  :root {
    --primary:#111827;
    --muted:#6b7280;
    --border:#e5e7eb;
    --soft:#f9fafb;
    --green:#10b981;
    --red:#dc2626;
    --amber:#f59e0b;
  }

  * { box-sizing:border-box; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial;
    margin:0;
    padding:0;
    color:var(--primary);
    background:white;
  }

  .container {
    max-width: 800px;
    margin:0 auto;
    padding:30px;
  }

  .header {
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-bottom:2px solid var(--border);
    padding-bottom:16px;
    margin-bottom:20px;
  }

  .student-info {
    display:flex;
    gap:16px;
    align-items:center;
  }

  .avatar {
    width:80px;
    height:80px;
    border-radius:10px;
    background:#eef2ff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:700;
    font-size:24px;
    color:#4338ca;
    overflow:hidden;
  }

  .avatar img {
    width:100%;
    height:100%;
    object-fit:cover;
  }

  .student-name {
    font-size:20px;
    font-weight:700;
  }

  .student-sub {
    font-size:12px;
    color:var(--muted);
  }

  .summary {
    display:flex;
    gap:12px;
    margin-top:20px;
  }

  .card {
    flex:1;
    background:var(--soft);
    padding:14px;
    border-radius:8px;
    border:1px solid var(--border);
  }

  .card .label {
    font-size:12px;
    color:var(--muted);
  }

  .card .value {
    font-size:18px;
    font-weight:700;
    margin-top:4px;
  }

  .progress-wrapper {
    margin-top:18px;
  }

  .progress-bar {
    height:10px;
    background:#e5e7eb;
    border-radius:50px;
    overflow:hidden;
  }

  .progress-fill {
    height:100%;
    background:var(--green);
  }

  .course {
    margin-top:25px;
    padding:15px;
    border:1px solid var(--border);
    border-radius:8px;
    page-break-inside:avoid;
  }

  .course-head {
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    margin-bottom:10px;
  }

  .course-title {
    font-weight:700;
  }

  .amount-box {
    text-align:right;
    font-size:13px;
  }

  .ledger {
    border:1px solid var(--border);
    border-radius:6px;
    padding:12px;
    margin-top:10px;
    background:white;
  }

  table {
    width:100%;
    border-collapse:collapse;
    margin-top:10px;
  }

  th, td {
    border-bottom:1px solid var(--border);
    padding:8px;
    font-size:12px;
    text-align:left;
  }

  th {
    background:var(--soft);
    font-weight:600;
  }

  .badge {
    padding:4px 8px;
    border-radius:20px;
    font-size:10px;
    font-weight:600;
  }

  .paid { background:#ecfdf5; color:#065f46; }
  .due { background:#fef2f2; color:#7f1d1d; }
  .partial { background:#fffbeb; color:#92400e; }

  .footer {
    margin-top:25px;
    font-size:11px;
    color:var(--muted);
    text-align:center;
  }

  @page {
    size:A4;
    margin:60px 30px;
  }
</style>
</head>

<body>
<div class="container">

<%
const student = data.studentInfo || {};
const summary = data.summary || {};
const total = summary.overallTotalAmount || 0;
const paid = summary.overallPaidAmount || 0;
const due = summary.overallDueAmount || 0;
const pct = total > 0 ? Math.round((paid/total)*100) : 0;
const courses = data.breakdown || [];
%>

<div class="header">
  <div class="student-info">
    <div class="avatar">
      <% if(student.photo){ %>
        <img src="<%= student.photo %>" />
      <% } else { %>
        <%= (student.name || '').split(' ').map(s=>s[0]).slice(0,2).join('') %>
      <% } %>
    </div>
    <div>
      <div class="student-name"><%= student.name || '-' %></div>
      <div class="student-sub"><%= student.email || '-' %> • <%= student.phone || '-' %></div>
    </div>
  </div>
  <div style="font-size:12px;color:var(--muted)">
    Generated: <%= new Date().toLocaleDateString() %>
  </div>
</div>

<div class="summary">
  <div class="card">
    <div class="label">Total Fees</div>
    <div class="value">₹<%= total.toLocaleString('en-IN') %></div>
  </div>
  <div class="card">
    <div class="label">Total Paid</div>
    <div class="value">₹<%= paid.toLocaleString('en-IN') %></div>
  </div>
  <div class="card">
    <div class="label">Total Due</div>
    <div class="value">₹<%= due.toLocaleString('en-IN') %></div>
  </div>
</div>

<div class="progress-wrapper">
  <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--muted)">
    <span>Payment Progress</span>
    <span><%= pct %>%</span>
  </div>
  <div class="progress-bar">
    <div class="progress-fill" style="width:<%= pct %>%"></div>
  </div>
</div>

<% courses.forEach(function(c){ %>

<div class="course">
  <div class="course-head">
    <div>
      <div class="course-title"><%= c.course?.name || 'Course' %></div>
      <div style="font-size:12px;color:var(--muted)">
        Duration: <%= c.course?.duration || '-' %>
      </div>
    </div>
    <div class="amount-box">
      <div>Total: ₹<%= (c.totalAmount||0).toLocaleString('en-IN') %></div>
      <div>Paid: ₹<%= (c.totalPaid||0).toLocaleString('en-IN') %></div>
      <div style="color:var(--red)">Due: ₹<%= (c.totalDue||0).toLocaleString('en-IN') %></div>
    </div>
  </div>

  <% (c.ledgers || []).forEach(function(l){ %>
  <div class="ledger">
    <div style="display:flex;justify-content:space-between;">
      <div>
        <strong><%= l.status || '-' %></strong><br/>
        <span style="font-size:11px;color:var(--muted)">
          <%= l.paymentType || '' %>
        </span>
      </div>
      <div style="text-align:right">
        ₹<%= (l.paidAmount||0).toLocaleString('en-IN') %><br/>
        <span style="font-size:11px;color:var(--muted)">
          Total: ₹<%= (l.totalAmount||0).toLocaleString('en-IN') %>
        </span>
      </div>
    </div>

    <% if(l.installments && l.installments.length){ %>
    <table>
      <thead>
        <tr>
          <th>Installment</th>
          <th>Due Date</th>
          <th>Status</th>
          <th>Amount</th>
        </tr>
      </thead>
      <tbody>
        <% l.installments.forEach(function(it,idx){ %>
        <tr>
          <td>Installment <%= idx+1 %></td>
          <td><%= it.dueDate ? new Date(it.dueDate).toLocaleDateString() : '-' %></td>
          <td>
            <span class="badge <%= it.status==='PAID'?'paid':it.status==='DUE'?'due':'partial' %>">
              <%= it.status %>
            </span>
          </td>
          <td>₹<%= (it.amount||0).toLocaleString('en-IN') %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>
  <% }) %>

</div>
<% }) %>

<div class="footer">
  This is a system generated financial report.
</div>

</div>
</body>
</html>