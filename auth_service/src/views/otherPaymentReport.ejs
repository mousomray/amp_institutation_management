<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<title>Student Challan</title>

<style>
body{
  font-family: Arial, sans-serif;
  background:#f5f6fa;
  padding:20px;
}
.card{
  background:#fff;
  padding:25px;
  border-radius:10px;
  box-shadow:0 0 10px rgba(0,0,0,0.05);
}
.header{
  display:flex;
  justify-content:space-between;
  margin-bottom:20px;
}
.title{
  font-size:20px;
  font-weight:700;
}
.meta{
  font-size:13px;
  text-align:right;
}
.student-section{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
}
.student-info{
  font-size:14px;
}
.summary{
  border:1px solid #ddd;
  padding:15px;
  border-radius:6px;
  width:200px;
  font-size:14px;
}
.summary div{
  display:flex;
  justify-content:space-between;
  margin-bottom:6px;
}
.paid{ color:green; font-weight:600;}
.due{ color:red; font-weight:600;}

table{
  width:100%;
  border-collapse:collapse;
  margin-top:15px;
}
th,td{
  padding:10px;
  border-bottom:1px solid #ddd;
  text-align:left;
  font-size:14px;
}
th{
  background:#f0f2f5;
}
.total-row{
  font-weight:700;
}
.footer{
  margin-top:20px;
  font-size:12px;
  color:#777;
}
.status{
  font-weight:600;
}
.status.PAID{ color:green;}
.status.PARTIAL{ color:orange;}
.status.PENDING{ color:red;}
</style>
</head>

<body>

<div class="card">

  <div class="header">
    <div class="title">Other Payment Collection</div>
    <div class="meta">
      Challan No: <%= data._id %><br/>
      Date: <%= new Date(data.challanDate).toLocaleDateString() %>
    </div>
  </div>

  <div class="student-section">
    <div class="student-info">
      <strong><%= data.student.name %></strong><br/>
      <%= data.student.email || '' %><br/>
      <%= data.student.mobile || '' %>
    </div>

    <div class="summary">
      <div><span>Total:</span> <span>₹<%= data.totalAmount %></span></div>
      <div><span>Paid:</span> <span class="paid">₹<%= data.totalPaid %></span></div>
      <div><span>Due:</span> <span class="due">₹<%= data.totalDue %></span></div>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Fee Head</th>
        <th>Amount</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% data.payments.forEach(function(p){ %>
        <tr>
          <td><%= p.name %></td>
          <td>₹<%= p.amount %></td>
          <td class="status <%= p.status %>"><%= p.status %></td>
        </tr>
      <% }) %>

      <tr class="total-row">
        <td>Total</td>
        <td>₹<%= data.totalAmount %></td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <div class="footer">
    This is a system-generated challan. No signature is required.
  </div>

</div>

</body>
</html>
