<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Student Fees Report</title>
  <style>
    :root{
      --bg:#f7f9fb; --card:#ffffff; --muted:#6b7280; --accent:#0f172a; --success:#059669; --warning:#f59e0b; --danger:#ef4444; --glass:rgba(15,23,42,0.04);
      --radius:10px; --maxw:900px;
    }
    html,body{height:100%;margin:0;background:var(--bg);font-family:Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial; color:var(--accent);}
    .container{max-width:var(--maxw);margin:28px auto;padding:22px;}
    .card{background:var(--card);border-radius:var(--radius);box-shadow:0 6px 18px rgba(2,6,23,0.06);padding:18px;margin-bottom:14px}

    /* Print-friendly rules */
    @page { size: A4; margin: 110px 20px 70px 20px; }
    body { -webkit-print-color-adjust: exact; }
    .card { page-break-inside: avoid; break-inside: avoid; -webkit-column-break-inside: avoid; -webkit-region-break-inside: avoid; }
    .header, .brand { page-break-inside: avoid; }
    table { page-break-inside: auto; }
    thead { display: table-header-group; }
    tfoot { display: table-footer-group; }
    
    @media print {
      .container { margin: 0; padding: 8px 0; }
      .card { padding: 12px; margin-bottom: 8px; box-shadow: none; }
      .header { margin-bottom: 6px; }
      .summary { gap: 8px; margin-top: 6px; }
      .stat { padding: 8px; }
      .foot { margin-top: 6px; font-size: 10px; }
      .grid { gap: 8px; }
    }
    .header{display:flex;align-items:center;justify-content:space-between;gap:12px}
    .brand{display:flex;align-items:center;gap:12px}
    .logo{width:56px;height:56px;border-radius:10px;background:linear-gradient(135deg,#4f46e5,#06b6d4);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:18px}
    .title{font-size:18px;font-weight:700}
    .subtitle{font-size:12px;color:var(--muted)}

    .grid{display:flex;gap:12px;flex-wrap:wrap}
    .col{flex:1;min-width:180px}

    .student-info{display:flex;gap:14px;align-items:center}
    .avatar{width:72px;height:72px;border-radius:10px;background:var(--glass);display:flex;align-items:center;justify-content:center;font-weight:600;color:var(--accent)}
    .meta strong{display:block;font-size:14px}
    .meta .muted{color:var(--muted);font-size:13px}

    .summary{display:flex;gap:12px;margin-top:8px}
    .stat{flex:1;background:linear-gradient(180deg,rgba(0,0,0,0.01),transparent);padding:12px;border-radius:8px}
    .stat .num{font-size:18px;font-weight:700}
    .stat .label{font-size:12px;color:var(--muted)}

    .status{display:inline-block;padding:6px 10px;border-radius:999px;font-size:12px;font-weight:600}
    .status.paid{background:rgba(5,150,105,0.12);color:var(--success)}
    .status.partial{background:rgba(245,158,11,0.12);color:var(--warning)}
    .status.due{background:rgba(239,68,68,0.08);color:var(--danger)}

    table{width:100%;border-collapse:collapse;margin-top:8px}
    thead th{background:#f3f4f6;color:#374151;text-align:left;padding:10px;font-size:13px;border-bottom:1px solid #e6e9ef}
    tbody td{padding:10px;border-bottom:1px solid #f1f5f9;font-size:13px;color:#111827}
    tbody tr:nth-child(even){background:rgba(15,23,42,0.02)}

    .foot{font-size:12px;color:var(--muted);margin-top:8px;text-align:right}

    @media (max-width:720px){.header{flex-direction:column;align-items:flex-start}.summary{flex-direction:column}}
  </style>
</head>
<body>
  <div class="container">
    <div class="card header">
      <div class="brand">
        <div class="logo">IL</div>
        <div>
          <div class="title">Student Fees Report</div>
          <div class="subtitle">Detailed fees & installment summary</div>
        </div>
      </div>
      <div style="text-align:right">
        <div style="font-size:12px;color:var(--muted)">Report for</div>
        <div style="font-weight:700"><%= data.student.name %></div>
      </div>
    </div>

    <div class="card">
      <div class="grid">
        <div class="col student-info">
          <div class="avatar"><% if (data.student.photo) { %><img src="<%= data.student.photo %>" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:8px"> <% } else { %><%= (data.student.name || '').split(' ').map(n=>n[0]||'').slice(0,2).join('').toUpperCase() %> <% } %></div>
          <div class="meta">
            <strong><%= data.student.name %></strong>
            <div class="muted"><%= data.student.email || '—' %></div>
            <div class="muted">Course: <strong style="color:var(--accent)"><%= data.course.name %></strong></div>
          </div>
        </div>

        <div class="col">
          <div style="display:flex;align-items:center;justify-content:flex-end;gap:10px;flex-direction:column;align-items:flex-end">
            <div class="muted">Enrollment</div>
            <div style="font-weight:700"><%= data.enrollment?.enrollmentDate ? new Date(data.enrollment.enrollmentDate).toLocaleDateString() : '-' %></div>
            <div style="margin-top:8px">
              <span class="status <%= (data.status||'').toLowerCase()==='paid' ? 'paid' : (data.status||'').toLowerCase()==='partial' ? 'partial' : 'due' %>"><%= data.status %></span>
            </div>
          </div>
        </div>
      </div>

      <div class="summary">
        <div class="stat">
          <div class="label">Total Course Fees</div>
          <div class="num">₹<%= (data.enrollment?.totalFees ?? data.totalAmount ?? 0).toLocaleString('en-IN') %></div>
        </div>
        <div class="stat">
          <div class="label">Net Payable</div>
          <div class="num">₹<%= (data.enrollment?.netPayableAmount ?? 0).toLocaleString('en-IN') %></div>
        </div>
        <div class="stat">
          <div class="label">Paid</div>
          <div class="num">₹<%= (data.paidAmount ?? 0).toLocaleString('en-IN') %></div>
        </div>
        <div class="stat">
          <div class="label">Due</div>
          <div class="num">₹<%= (data.dueAmount ?? 0).toLocaleString('en-IN') %></div>
        </div>
      </div>
    </div>

    <% if (data.installments && data.installments.length > 0) { %>
      <div class="card">
        <div style="display:flex;align-items:center;justify-content:space-between">
          <div style="font-weight:700">Installment Details</div>
          <div class="muted">Count: <strong><%= data.installments.length %></strong></div>
        </div>

        <div style="overflow:auto;margin-top:10px">
          <table>
            <thead>
              <tr>
                <th>Due Date</th>
                <th>Amount (₹)</th>
                <th>Paid (₹)</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% data.installments.forEach(inst => { %>
                <tr>
                  <td><%= inst.dueDate ? new Date(inst.dueDate).toLocaleDateString() : '-' %></td>
                  <td style="white-space:nowrap;text-align:right"><%= (inst.amount ?? 0).toLocaleString('en-IN') %></td>
                  <td style="white-space:nowrap;text-align:right"><%= (inst.paidAmount ?? 0).toLocaleString('en-IN') %></td>
                  <td><span class="status <%= (inst.status||'').toLowerCase()==='paid' ? 'paid' : (inst.status||'').toLowerCase()==='partial' ? 'partial' : 'due' %>"><%= inst.status %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="card"><div class="muted">No installment records available for this student.</div></div>
    <% } %>

    <div class="foot">Generated: <%= new Date().toLocaleString() %></div>
  </div>
</body>
</html>
