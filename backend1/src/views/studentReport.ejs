<!doctype html>
<html>
<head>
<meta charset="utf-8" />
<title>Student Financial Report</title>

<style>
  :root {
    --primary:#111827;
    --muted:#6b7280;
    --border:#e5e7eb;
    --soft:#f9fafb;
    --green:#10b981;
    --red:#dc2626;
    --amber:#f59e0b;
    --blue:#3b82f6;
  }

  * { box-sizing:border-box; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial;
    margin:0;
    padding:0;
    color:var(--primary);
    background:white;
  }

  .container {
    max-width: 800px;
    margin:0 auto;
    padding:30px;
  }

  /* ===== INSTITUTION HEADER ===== */
  .institution-header {
    background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
    margin: -30px -30px 20px -30px;
    padding: 25px 30px;
    color: white;
  }

  .institution-name {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 8px;
    letter-spacing: -0.3px;
  }

  .institution-details {
    font-size: 13px;
    opacity: 0.95;
    line-height: 1.6;
  }

  .institution-details div {
    margin: 3px 0;
  }

  /* ===== REPORT TITLE ===== */
  .report-title {
    text-align: center;
    margin: 20px 0;
    padding-bottom: 15px;
    border-bottom: 2px solid var(--border);
  }

  .report-title h1 {
    font-size: 22px;
    font-weight: 700;
    color: var(--primary);
    margin: 0 0 5px 0;
  }

  .report-title .subtitle {
    font-size: 12px;
    color: var(--muted);
  }

  /* ===== STUDENT INFO (NO PHOTO) ===== */
  .student-section {
    background: var(--soft);
    padding: 20px;
    border-radius: 10px;
    border-left: 4px solid var(--blue);
    margin-bottom: 20px;
  }

  .student-name {
    font-size: 20px;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 8px;
  }

  .student-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
  }

  .student-details .detail-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .student-details .detail-item .icon {
    font-size: 14px;
  }

  .summary {
    display:flex;
    gap:12px;
    margin-top:20px;
  }

  .card {
    flex:1;
    background:var(--soft);
    padding:14px;
    border-radius:8px;
    border:1px solid var(--border);
  }

  .card .label {
    font-size:12px;
    color:var(--muted);
  }

  .card .value {
    font-size:18px;
    font-weight:700;
    margin-top:4px;
  }

  .progress-wrapper {
    margin-top:18px;
  }

  .progress-bar {
    height:10px;
    background:#e5e7eb;
    border-radius:50px;
    overflow:hidden;
  }

  .progress-fill {
    height:100%;
    background:var(--green);
  }

  .course {
    margin-top:25px;
    padding:15px;
    border:1px solid var(--border);
    border-radius:8px;
    page-break-inside:avoid;
  }

  .course-head {
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    margin-bottom:10px;
  }

  .course-title {
    font-weight:700;
  }

  .amount-box {
    text-align:right;
    font-size:13px;
  }

  .ledger {
    border:1px solid var(--border);
    border-radius:6px;
    padding:12px;
    margin-top:10px;
    background:white;
  }

  table {
    width:100%;
    border-collapse:collapse;
    margin-top:10px;
  }

  th, td {
    border-bottom:1px solid var(--border);
    padding:8px;
    font-size:12px;
    text-align:left;
  }

  th {
    background:var(--soft);
    font-weight:600;
  }

  .badge {
    padding:4px 8px;
    border-radius:20px;
    font-size:10px;
    font-weight:600;
  }

  .paid { background:#ecfdf5; color:#065f46; }
  .due { background:#fef2f2; color:#7f1d1d; }
  .partial { background:#fffbeb; color:#92400e; }

  .footer {
    margin-top:25px;
    padding-top:15px;
    border-top:1px solid var(--border);
    font-size:11px;
    color:var(--muted);
    text-align:center;
  }

  @page {
    size:A4;
    margin:60px 30px;
  }
</style>
</head>

<body>
<div class="container">

<%
// Institution data
const institution = data.institution || {};

// Student and summary data from result
const student = data.result?.studentInfo || {};
const summary = data.result?.summary || {};
const total = summary.overallTotalAmount || 0;
const paid = summary.overallPaidAmount || 0;
const due = summary.overallDueAmount || 0;
const pct = total > 0 ? Math.round((paid/total)*100) : 0;
const courses = data.result?.breakdown || [];
%>

<!-- ===== INSTITUTION HEADER ===== -->
<div class="institution-header">
  <div class="institution-name"><%= institution.name || 'Institution Name' %></div>
  <div class="institution-details">
    <% if(institution.email){ %>
    <div>📧 <%= institution.email %></div>
    <% } %>
    <% if(institution.phone){ %>
    <div>📞 <%= institution.phone %></div>
    <% } %>
    <% if(institution.address){ %>
    <div>📍 <%= institution.address %></div>
    <% } %>
  </div>
</div>

<!-- ===== REPORT TITLE ===== -->
<div class="report-title">
  <h1>Student Financial Report</h1>
  <div class="subtitle">Generated on <%= new Date().toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
</div>

<!-- ===== STUDENT INFO (NO PHOTO) ===== -->
<div class="student-section">
  <div class="student-name"><%= student.name || 'Student Name' %></div>
  <div class="student-details">
    <% if(student.studentId){ %>
    <div class="detail-item">
      <span class="icon">🆔</span>
      <span>ID: <%= student.studentId %></span>
    </div>
    <% } %>
    <% if(student.email){ %>
    <div class="detail-item">
      <span class="icon">📧</span>
      <span><%= student.email %></span>
    </div>
    <% } %>
    <% if(student.phone){ %>
    <div class="detail-item">
      <span class="icon">📱</span>
      <span><%= student.phone %></span>
    </div>
    <% } %>
    <% if(student.course){ %>
    <div class="detail-item">
      <span class="icon">📚</span>
      <span><%= student.course %></span>
    </div>
    <% } %>
  </div>
</div>

<!-- ===== SUMMARY CARDS ===== -->
<div class="summary">
  <div class="card">
    <div class="label">Total Fees</div>
    <div class="value">₹<%= total.toLocaleString('en-IN') %></div>
  </div>
  <div class="card">
    <div class="label">Total Paid</div>
    <div class="value" style="color:var(--green)">₹<%= paid.toLocaleString('en-IN') %></div>
  </div>
  <div class="card">
    <div class="label">Total Due</div>
    <div class="value" style="color:var(--red)">₹<%= due.toLocaleString('en-IN') %></div>
  </div>
</div>

<!-- ===== PROGRESS BAR ===== -->
<div class="progress-wrapper">
  <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:6px">
    <span>Payment Progress</span>
    <span><%= pct %>%</span>
  </div>
  <div class="progress-bar">
    <div class="progress-fill" style="width:<%= pct %>%"></div>
  </div>
</div>

<!-- ===== COURSES BREAKDOWN ===== -->
<% if(courses && courses.length > 0){ %>
  <% courses.forEach(function(c){ %>

  <div class="course">
    <div class="course-head">
      <div>
        <div class="course-title"><%= c.course?.name || 'Course' %></div>
        <% if(c.course?.duration){ %>
        <div style="font-size:12px;color:var(--muted)">
          Duration: <%= c.course.duration %>
        </div>
        <% } %>
      </div>
      <div class="amount-box">
        <div style="font-weight:600">Total: ₹<%= (c.totalAmount||0).toLocaleString('en-IN') %></div>
        <div style="color:var(--green)">Paid: ₹<%= (c.totalPaid||0).toLocaleString('en-IN') %></div>
        <div style="color:var(--red)">Due: ₹<%= (c.totalDue||0).toLocaleString('en-IN') %></div>
      </div>
    </div>

    <!-- ===== LEDGERS ===== -->
    <% (c.ledgers || []).forEach(function(l){ %>
    <div class="ledger">
      <div style="display:flex;justify-content:space-between;margin-bottom:8px">
        <div>
          <strong style="font-size:14px"><%= l.status || 'Status' %></strong>
          <% if(l.paymentType){ %>
          <br/>
          <span style="font-size:11px;color:var(--muted)">
            <%= l.paymentType %>
          </span>
          <% } %>
        </div>
        <div style="text-align:right">
          <div style="font-size:16px;font-weight:700;color:var(--green)">
            ₹<%= (l.paidAmount||0).toLocaleString('en-IN') %>
          </div>
          <span style="font-size:11px;color:var(--muted)">
            of ₹<%= (l.totalAmount||0).toLocaleString('en-IN') %>
          </span>
        </div>
      </div>

      <!-- ===== INSTALLMENTS TABLE ===== -->
      <% if(l.installments && l.installments.length > 0){ %>
      <table>
        <thead>
          <tr>
            <th>Installment</th>
            <th>Due Date</th>
            <th>Amount</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% l.installments.forEach(function(it,idx){ %>
          <tr>
            <td>#<%= idx+1 %></td>
            <td>
              <%= it.dueDate ? new Date(it.dueDate).toLocaleDateString('en-IN') : '-' %>
            </td>
            <td style="font-weight:600">
              ₹<%= (it.amount||0).toLocaleString('en-IN') %>
            </td>
            <td>
              <span class="badge <%= it.status==='PAID'?'paid':it.status==='DUE'?'due':'partial' %>">
                <%= it.status || 'PENDING' %>
              </span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
    <% }) %>

  </div>
  <% }) %>
<% } else { %>
  <div style="text-align:center;padding:40px;color:var(--muted)">
    <div style="font-size:48px;margin-bottom:10px">📄</div>
    <div>No course data available</div>
  </div>
<% } %>

<!-- ===== FOOTER ===== -->
<div class="footer">
  <div style="margin-bottom:5px">
    This is a system generated financial report from <strong><%= institution.name || 'Institution' %></strong>
  </div>
  <div>
    For any queries, contact: <%= institution.email || '-' %>
    <% if(institution.phone){ %> | <%= institution.phone %><% } %>
  </div>
</div>

</div>
</body>
</html>