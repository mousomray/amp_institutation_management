<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Student Financial Report</title>
  <style>
    :root {
      --primary: #1e40af;
      --secondary: #3b82f6;
      --success: #059669;
      --danger: #dc2626;
      --muted: #6b7280;
      --border: #e5e7eb;
      --bg: #f9fafb;
    }

    body {
      font-family: Arial, sans-serif;
      font-size: 12px;
      margin: 0;
      padding: 20px;
      background: white;
    }

    /* ===== INSTITUTION HEADER ===== */
    .institution-header {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      padding: 20px;
      margin: -20px -20px 20px -20px;
      color: white;
      text-align: center;
    }

    .institution-header h1 {
      margin: 0 0 8px 0;
      font-size: 20px;
      font-weight: bold;
    }

    .institution-header .details {
      font-size: 11px;
      line-height: 1.6;
      opacity: 0.95;
    }

    /* ===== REPORT HEADER ===== */
    .header {
      text-align: center;
      margin-bottom: 20px;
      padding-bottom: 15px;
      border-bottom: 2px solid var(--border);
    }

    .header h2 {
      margin: 0 0 5px 0;
      font-size: 16px;
      color: var(--primary);
    }

    .header p {
      margin: 0;
      font-size: 11px;
      color: var(--muted);
    }

    /* ===== SUMMARY ===== */
    .summary {
      margin-bottom: 20px;
    }

    .summary table {
      width: 100%;
      border-collapse: collapse;
    }

    .summary th,
    .summary td {
      border: 1px solid var(--border);
      padding: 10px;
      text-align: right;
      font-size: 12px;
    }

    .summary th {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      color: white;
      font-weight: bold;
      text-transform: uppercase;
      font-size: 11px;
      letter-spacing: 0.5px;
    }

    .summary td {
      font-weight: bold;
      font-size: 14px;
    }

    .summary .total-col {
      color: var(--primary);
    }

    .summary .paid-col {
      color: var(--success);
    }

    .summary .due-col {
      color: var(--danger);
    }

    /* ===== DETAILS TABLE ===== */
    .details {
      margin-top: 20px;
    }

    .details h3 {
      font-size: 14px;
      color: var(--primary);
      margin-bottom: 10px;
      padding-bottom: 5px;
      border-bottom: 2px solid var(--secondary);
    }

    .details table {
      width: 100%;
      border-collapse: collapse;
    }

    .details th,
    .details td {
      border: 1px solid var(--border);
      padding: 8px;
      text-align: left;
      font-size: 11px;
    }

    .details th {
      background: var(--bg);
      color: var(--primary);
      font-weight: bold;
      text-transform: uppercase;
      font-size: 10px;
      letter-spacing: 0.3px;
    }

    .details tbody tr:nth-child(even) {
      background: #fafafa;
    }

    .details tbody tr:hover {
      background: #f0f4ff;
    }

    .details td.amount {
      text-align: right;
      font-weight: bold;
      font-family: 'Courier New', monospace;
    }

    .details td.paid {
      color: var(--success);
    }

    .details td.due {
      color: var(--danger);
    }

    /* ===== FOOTER ===== */
    .footer {
      margin-top: 30px;
      padding-top: 15px;
      border-top: 1px solid var(--border);
      text-align: center;
      font-size: 10px;
      color: var(--muted);
    }

    .footer .note {
      margin-bottom: 5px;
    }

    /* ===== PRINT STYLES ===== */
    @media print {
      body {
        padding: 10px;
      }
      .institution-header {
        margin: -10px -10px 10px -10px;
        padding: 15px;
      }
      .summary th,
      .summary td {
        padding: 6px;
      }
      .details th,
      .details td {
        padding: 5px;
      }
    }

    @page {
      size: A4;
      margin: 15mm;
    }
  </style>
</head>

<body>
  <%
  const institution = data.institution || {};
  const reportData = data.reportData || {};
  const summary = reportData.summary || {};
  const allData = reportData.allData || [];
  %>

  <!-- ===== INSTITUTION HEADER ===== -->
  <div class="institution-header">
    <h1><%= institution.name || 'Institution Name' %></h1>
    <div class="details">
      <% if(institution.email){ %>
        📧 <%= institution.email %>
      <% } %>
      <% if(institution.phone){ %>
        | 📞 <%= institution.phone %>
      <% } %>
      <% if(institution.address){ %>
        <br>📍 <%= institution.address %>
      <% } %>
    </div>
  </div>

  <!-- ===== REPORT HEADER ===== -->
  <div class="header">
    <h2>Student Financial Report</h2>
    <p>Generated on <%= new Date().toLocaleDateString('en-IN', { 
      year: 'numeric', 
      month: 'long', 
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    }) %></p>
  </div>

  <!-- ===== SUMMARY ===== -->
  <div class="summary">
    <table>
      <thead>
        <tr>
          <th>Total Amount</th>
          <th>Total Paid</th>
          <th>Total Due</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="total-col">
            ₹<%= (summary?.totalAmount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          </td>
          <td class="paid-col">
            ₹<%= (summary?.totalPaidAmount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          </td>
          <td class="due-col">
            ₹<%= (summary?.totalDueAmount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- ===== DETAILED TABLE ===== -->
  <div class="details">
    <h3>Detailed Breakdown</h3>
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Student Name</th>
          <th>Course</th>
          <th>Payment Type</th>
          <th style="text-align: right">Total Amount</th>
          <th style="text-align: right">Paid Amount</th>
          <th style="text-align: right">Due Amount</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        <% if(allData && allData.length > 0) { %>
          <% allData.forEach((item, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= item.student?.name || '-' %></td>
              <td><%= item.course?.name || '-' %></td>
              <td><%= item.paymentType || '-' %></td>
              <td class="amount">
                ₹<%= (item.totalAmount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
              </td>
              <td class="amount paid">
                ₹<%= (item.paidAmount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
              </td>
              <td class="amount due">
                ₹<%= (item.dueAmount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
              </td>
              <td><%= item.createdAt ? new Date(item.createdAt).toLocaleDateString('en-IN') : '-' %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" style="text-align: center; padding: 20px; color: #6b7280;">
              No data available
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- ===== FOOTER ===== -->
  <div class="footer">
    <div class="note">
      This is a system generated report from <strong><%= institution.name || 'Institution' %></strong>
    </div>
    <div>
      For queries, contact: <%= institution.email || '-' %>
      <% if(institution.phone){ %> | <%= institution.phone %><% } %>
    </div>
  </div>

</body>

</html>